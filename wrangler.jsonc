{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daegu-fukuoka-trip",
  "main": "src/index.js",
  "compatibility_date": "2026-05-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
